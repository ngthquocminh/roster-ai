# The browser-facing API origin is the SPA's own origin. During `npm run dev`,
# Vite proxies `/api` to FastAPI at 127.0.0.1:8000, preserving the
# __Host-/SameSite application-session cookie. Production should set this to
# the deployed SPA origin served by the same edge.
VITE_API_BASE_URL=http://localhost:5173
