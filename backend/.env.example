# Copy this file to backend/.env and fill in values as needed.
# backend/.env is gitignored; never commit real secrets.
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
#
# Select one live provider and configure its separate credential/model. Leaving
# live-provider credentials unset with LLM_PROVIDER=stub keeps the deterministic,
# keyless default pytest suite (`-m "not live"`) green.

LLM_PROVIDER=stub
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# LLM_PROVIDER=anthropic uses Anthropic's Messages API. This is intentionally
# separate from LLM_MODEL, which is Gemini-only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# LLM_PROVIDER=openrouter uses this separate OpenAI-compatible configuration.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional telemetry pricing in USD per million tokens. When both are unset
# (the default zero values), completed agent tasks are labelled unpriced; zero
# does not assert that provider usage is free.
AGENT_MODEL_INPUT_USD_PER_MTOK=0
AGENT_MODEL_OUTPUT_USD_PER_MTOK=0

# Optional, separate prices for cache tokens (a provider's `input_tokens`
# figure already includes these; pricing cache tokens at the ordinary input
# rate above would double-bill them). Zero means cache tokens contribute
# nothing to the estimate, not that caching is free -- set explicitly to
# price it.
AGENT_MODEL_CACHE_READ_USD_PER_MTOK=0
AGENT_MODEL_CACHE_WRITE_USD_PER_MTOK=0

# Browser origins allowed to call this API (BE-01). Comma-separated, no
# spaces required (whitespace is trimmed). Default covers both Vite ports:
# 5173 (npm run dev) and 4173 (npm run preview, serving the built dist/).
#
# TRAP: http://127.0.0.1:5173 is a DIFFERENT origin from http://localhost:5173.
# Browsing to the 127.0.0.1 form will get silently blocked by CORS -- it looks
# identical to "backend is down" in the browser console. Use localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Governed fixture history (PostgreSQL via psycopg v3).
#
# Two separate credentials (AD-23): the API itself connects as the
# restricted, non-superuser shiftmind_login (no direct table grants — it
# only reaches SET LOCAL ROLE shiftmind_runtime and the auth.* SECURITY
# DEFINER functions). Alembic migrations and the operator-only
# seed_planner.py use the privileged rosterai account instead. Never point
# ROSTERAI_DATABASE_URL at the privileged account.
ROSTERAI_DATABASE_URL=postgresql+psycopg://shiftmind_login:shiftmind_login@localhost:5432/rosterai
ROSTERAI_PROVISIONING_DATABASE_URL=postgresql+psycopg://rosterai:rosterai@localhost:5432/rosterai

# Idempotent local bootstrap identity and production worker composition.
SHIFTMIND_SEED_PLANNER_SUBJECT=local-planner
SHIFTMIND_SEED_PLANNER_EMAIL=planner@shiftmind.local
SHIFTMIND_WORKER_RUNTIME_FACTORY=worker.composition:create_runtime

# Keyless/deterministic by default; select a live provider:model explicitly.
AGENT_RUNTIME_MODEL=deterministic
AGENT_RUNTIME_API_KEY=

# Presence of this file makes the legacy API refuse mutating requests.
ROSTERAI_MAINTENANCE_FLAG=var/gate-a-maintenance

# BFF OIDC authentication. The deterministic fake provider is the safe
# keyless default for local development and CI; use cognito only with a
# configured issuer/client.
OIDC_PROVIDER=fake
OIDC_ISSUER=http://shiftmind.test/oidc
OIDC_CLIENT_ID=shiftmind-local
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://shiftmind.test/api/v1/auth/callback
APP_BASE_URL=http://shiftmind.test
SESSION_TTL_S=3600

# HMAC pepper for deriving the CSRF token from the session token — set a
# real per-deployment secret in production; the default below is fine for
# local dev only.
CSRF_SECRET=shiftmind-local-csrf-secret

# Trace export to Logfire (Story 5.9). Unset = no exporter is constructed and
# nothing leaves the process. Every exported span passes the export-boundary
# sanitizer (adapters/telemetry/span_policy.py). EU projects use
# https://logfire-eu.pydantic.dev. Never commit a real token.
# LOGFIRE_TOKEN=
# LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# Tier-1 grounding claim-support checker (G' phase 3): verifies a fact's
# WORDING against its already tier-0-verified record via an external model,
# flagging low-confidence phrasing without stripping or retrying anything.
# off/shadow/flag; flag also marks a fact below the threshold. No key for the
# resolved provider (typesafe here, else OPENROUTER_API_KEY above, else the
# agent's own key when it runs on openrouter:...) disables the checker with
# one warning -- fail-open, the turn is never affected.
GROUNDING_TIER1_MODE=flag
GROUNDING_TIER1_FLAG_THRESHOLD=0.5
GROUNDING_TIER1_PROVIDER=auto
# Also the live conversation suite's judge key: its default judge model is
# typesafe:jev-1.13.0. Set LIVE_CONVERSATION_JUDGE_MODEL=openrouter:<model>
# (with LIVE_CONVERSATION_JUDGE_API_KEY, else AGENT_RUNTIME_API_KEY) to judge
# with the OpenRouter LLM judge instead.
TYPESAFE_API_KEY=
GROUNDING_TIER1_MODEL=
GROUNDING_TIER1_TIMEOUT_SECONDS=5.0
GROUNDING_TIER1_TOKEN_BUDGET=4000

# Agent turn routing: one Jev `choice` call per new planner message routes it
# to scheduling (full prompt and tools), direct (short answer, no tools) or
# out_of_scope (refusal only). Same provider/key/model as the tier-1 checker.
# Error, timeout, no key or a probability below the threshold -> scheduling.
# off: no routing request; every turn takes the scheduling path.
AGENT_ROUTER_MODE=on
AGENT_ROUTER_THRESHOLD=0.85
AGENT_ROUTER_TIMEOUT_SECONDS=2.0
