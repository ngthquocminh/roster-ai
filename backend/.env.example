# Copy this file to backend/.env and fill in values as needed.
# backend/.env is gitignored; never commit real secrets.
#
# Get a free Gemini API key at: https://aistudio.google.com/apikey
#
# LLM_PROVIDER=gemini requires a real GEMINI_API_KEY. Leaving these unset (or
# LLM_PROVIDER=stub) falls back to the deterministic stub provider — no key
# needed, and the default pytest suite (`-m "not live"`) stays green.

LLM_PROVIDER=stub
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
