# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Solver / run artifacts
*.lp
*.sol
output/
*.log

# SQLite app database (created at runtime)
*.db
*.db-wal
*.db-shm
backend/var/

# Full weekly source input (~16 MB) — kept local for regenerating the fixture,
# not committed. Only the small generated data/sample_tiny_input.json is tracked.
data/sample_weekly_input.json

# Env files (secrets) — keep the documented example tracked
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node (future frontend)
node_modules/
dist/

# Claude Code local tooling — reinstallable, stays out of history.
# .claude/CLAUDE.md is authored by us and stays tracked.
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/scripts/
.claude/worktrees/
.claude/package.json
.claude/settings.local.json
.claude/skills/

# BMad: reinstallable skill-package mirror for Codex/Gemini (bmad-loop init
# regenerates it) — same treatment as the already-ignored .claude/skills/
.agents/skills/

# Codex local tooling — project-local, reinstallable
.codex/agents/
.codex/scripts/
.codex/config.toml
.codex/hooks.json

# Machine-readable test reports written at the repository root by the CI jobs
# in .github/workflows/ci.yml (and by anyone mirroring them locally per
# docs/CI.md). Regenerable, and leaving them untracked matters: a dirty tree
# makes backend/tests/test_evidence_binding.py skip its binding-realism check,
# which the CI skip ceiling then reports as a failure.
/frontend-vitest.json
/playwright.json

# Local, content-addressed container build metadata.
/.build/
/.local/
/.codeboarding/

# Planning workspace (BMad config, plans, specs, stories, retros). Each of
# _bmad/ and _bmad-output/ is its own nested git repository pushed to a private
# remote, so none of it is ever published here. _bmad-output/test-artifacts/
# also receives the JUnit XML the Gate A/B readiness reports consume; it must
# never be written into evidence/.
/_bmad/
/_bmad-output/
/.bmad-loop/
# superpowers skills write specs and plans here by default.
/docs/superpowers/
