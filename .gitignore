# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Solver / run artifacts
*.lp
*.sol
output/
*.log

# SQLite app database (created at runtime)
*.db
*.db-wal
*.db-shm
backend/var/

# Full weekly source input (~16 MB) — kept local for regenerating the fixture,
# not committed. Only the small generated data/sample_tiny_input.json is tracked.
data/sample_weekly_input.json

# Env files (secrets) — keep the documented example tracked
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node (future frontend)
node_modules/
dist/

# GSD Core — installed project-locally via `npx @opengsd/gsd-core@latest --claude --local`.
# Reinstallable from that one command, so the tree stays out of history.
# .claude/CLAUDE.md is authored by us and stays tracked.
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/scripts/
.claude/gsd-core/
.claude/worktrees/
.claude/package.json
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/.gsd-profile
.claude/settings.local.json
.claude/skills/

# Codegen intermediate (frontend/src/api/schema.d.ts is the committed derivative — see 01-04-PLAN.md)
frontend/openapi.json
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# BMad: personal install answers, never shared across teammates/machines
_bmad/config.user.yaml
_bmad/config.user.toml

# BMad: reinstallable skill-package mirror for Codex/Gemini (bmad-loop init
# regenerates it) — same treatment as the already-ignored .claude/skills/
.agents/skills/
